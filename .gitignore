# ── Generated geometry ────────────────────────────────────────────────────────
# Every STL in here is reproducible from scripts/generate_tiles.py and the
# pipeline. They are 17-69 MB each (~2.1 GB total) and must not enter git.
stl_output/
*.stl

# ── Third-party dataset ───────────────────────────────────────────────────────
# 4.6 GB of externally-published impact data. Not ours to redistribute.
# See DATA.md for provenance and how to obtain it.
dataverse_files/

# ── Pipeline outputs ──────────────────────────────────────────────────────────
# Regenerated by `python scripts/run_pipeline.py`. One example run is committed
# under docs/example_output/ so co-researchers can see the shape of the results
# without running anything.
outputs/importance/
outputs/*.png
outputs/proposed_designs.csv
outputs/pipeline_report.md

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ── Local machine config ──────────────────────────────────────────────────────
# The Fusion add-in reads paths from here; each researcher has their own.
fusion_addin/HelmetLattice/local_config.py
.env

# ── Editors / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ── Run stderr ────────────────────────────────────────────────────────────────
# Solver/library chatter only ("BFGS update error2", trimesh divide warnings)
# and it carries local interpreter paths. Run stdout (*.log) is kept.
runs/**/*.err
